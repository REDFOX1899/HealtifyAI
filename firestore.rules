rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private beta: only the owner's account may use the app at all.
    function isAllowedAccount() {
      return request.auth != null
        && request.auth.token.email in ['shantanupatil1899@gmail.com'];
    }
    // Users may only read/write their own document tree.
    match /users/{userId} {
      allow read, write: if isAllowedAccount() && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if isAllowedAccount() && request.auth.uid == userId;
      }
    }
    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
