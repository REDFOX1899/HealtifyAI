rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Private beta: only the owner's account may use the app at all.
    function isAllowedAccount() {
      return request.auth != null
        && request.auth.token.email in ['shantanupatil1899@gmail.com'];
    }
    // Users may only upload/read their own photos.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAllowedAccount() && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
